<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UGL.App.ViewModels"
             xmlns:cfg="clr-namespace:UGL.App.ViewModels.Config"
             xmlns:views="clr-namespace:UGL.App.Views.Config"
             xmlns:controls="clr-namespace:UGL.App.Views.Controls"
             xmlns:views2="clr-namespace:UGL.App.Views"
             x:Class="UGL.App.Views.ConfigEditorView"
             x:DataType="vm:ConfigEditorViewModel">

  <UserControl.Styles>
    <!-- Quit row styled distinctly (red) so it reads as a different kind of action
         from the tab rows above it. Selector targets TextBlock since that's where
         Classes.quitRow is actually applied below (was previously mismatched against
         ListBoxItem, which meant this style never actually applied). -->
    <Style Selector="TextBlock.quitRow">
      <Setter Property="Foreground" Value="{DynamicResource UGL.DangerColor}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Non-selectable group header row (Content / Appearance / System) — small
         uppercase caption, disabled so it can't be highlighted or clicked. -->
    <Style Selector="TextBlock.menuHeader">
      <Setter Property="Foreground" Value="{DynamicResource UGL.AccentColor}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>

    <!-- Strong, guaranteed-visible selection highlight for every list in Settings —
         sidebar menu, Peripheral devices, Games, Systems, Audio, Theme — since the
         default theme's selected-item highlight was too subtle against this dark UI
         to reliably tell what's currently selected while navigating with a controller.
         A tinted background + 3px left accent bar (rather than a full solid fill)
         keeps the same instant legibility with a lighter touch. -->
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource UGL.SidebarSelectionTint}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.AccentColor}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>

    <!-- Header rows are visually distinct and structurally not part of the
         selectable set — disabling them keeps ListBox from ever highlighting
         or selecting one, whether via keyboard (NavigateMenuUp/Down already
         skips them) or a stray mouse click. -->
    <Style Selector="ListBox#SettingsMenuList ListBoxItem" x:DataType="vm:SettingsMenuItem">
      <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
    </Style>

    <!-- Virtual keyboard keys: default state and highlighted state are BOTH styles
         (not a local Background attribute) so the highlighted style can actually
         override the default — a local XAML attribute would always win over any
         style setter regardless of which classes are applied, which was the actual
         bug before (the key Borders had Background set locally, silently blocking
         the highlight style from ever taking visible effect). -->
    <Style Selector="Border.vkKey">
      <Setter Property="Background" Value="{DynamicResource UGL.Divider}"/>
    </Style>
    <Style Selector="Border.vkKey.keyHighlighted">
      <Setter Property="Background" Value="{DynamicResource UGL.AccentColor}"/>
    </Style>

    <!-- Shared field-focus highlight, reused across every tab (Games, Paths, Systems,
         Theme, etc.) — not just a Games-specific style. Default and highlighted states
         are both styles (not a local attribute) for the same reason as everywhere else:
         a local value would always win over a style setter regardless of class match. -->
    <Style Selector="Border.cfgField">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Border.cfgField.fieldFocused">
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.AccentColor}"/>
    </Style>
    <Style Selector="Button.cfgField">
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.cfgField.fieldFocused">
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.AccentColor}"/>
    </Style>

    <!-- Shared Delete-button styling (recommendation 10) — reuses the same red as
         the Quit row instead of every tab's Delete button using plain default styling. -->
    <Style Selector="Button.deleteBtn">
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.DangerColor}"/>
      <Setter Property="Foreground" Value="{DynamicResource UGL.DangerColor}"/>
    </Style>

    <!-- Shared section captions/dividers, reused across tab content (Games, Paths,
         etc.) to break long flat forms into labeled groups. -->
    <Style Selector="TextBlock.sectionCaption">
      <Setter Property="Foreground" Value="{DynamicResource UGL.AccentColor}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="Border.sectionDivider">
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.Divider}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </UserControl.Styles>

  <!-- Full-screen semi-transparent backdrop -->
  <Grid>
    <Border Background="{DynamicResource UGL.ScrimHeavy}"/>

    <Grid RowDefinitions="60,*,60" Margin="40,32">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="White"/>
          <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="White"/>
        </StackPanel>

        <Button Grid.Column="2"
                x:Name="CloseBtn"
                Padding="16,8"
                Click="OnCloseClick"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
            <TextBlock Text="Close"/>
          </StackPanel>
        </Button>

      </Grid>

      <!-- Sidebar menu + tab content -->
      <Grid Grid.Row="1" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding IsContentFocused, Converter={x:Static views2:BoolToSidebarWidthConverter.Instance}}"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Unified settings menu. D-pad Up/Down moves the highlight natively (ListBox
             handles this itself once focused); selecting a tab row switches content
             immediately; Quit requires an explicit confirm, not just a highlight.
             Collapses to width 0 once content is entered (A-enter) — see
             ConfigEditorViewModel.IsContentFocused / EnterContent / ExitContent. -->
        <ListBox x:Name="SettingsMenuList"
                 Grid.Column="0"
                 Margin="0,0,16,0"
                 IsVisible="{Binding !IsContentFocused}"
                 Background="{DynamicResource UGL.PanelBackground}"
                 BorderBrush="{DynamicResource UGL.Divider}"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="6"
                 Tapped="OnMenuItemTapped"
                 ItemsSource="{Binding MenuItems}"
                 SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsMenuItem">
              <Panel>
                <TextBlock Text="{Binding Label}"
                           Classes="menuHeader"
                           Padding="12,10,12,2"
                           IsVisible="{Binding IsHeader}"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10"
                            IsVisible="{Binding !IsHeader}">
                  <TextBlock Text="{Binding Icon}"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="16"
                             Width="18"
                             Classes.quitRow="{Binding IsQuit}"/>
                  <TextBlock Text="{Binding Label}"
                             FontSize="16"
                             Classes.quitRow="{Binding IsQuit}"/>
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1"
                Background="{DynamicResource UGL.PanelBackground}"
                BorderBrush="{DynamicResource UGL.Divider}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24,16">
          <Grid>
            <Border IsVisible="{Binding IsCategoriesTabActive}">
              <views:CategoriesConfigView DataContext="{Binding Categories}"/>
            </Border>
            <Border IsVisible="{Binding IsGamesTabActive}">
              <views:GamesConfigView DataContext="{Binding Games}"/>
            </Border>
            <Border IsVisible="{Binding IsSystemsTabActive}">
              <views:SystemsConfigView DataContext="{Binding Systems}"/>
            </Border>
            <Border IsVisible="{Binding IsAudioTabActive}">
              <views:AudioConfigView DataContext="{Binding Audio}"/>
            </Border>
            <Border IsVisible="{Binding IsThemeTabActive}">
              <views:ThemeConfigView DataContext="{Binding Theme}"/>
            </Border>
            <Border IsVisible="{Binding IsCardHighlightTabActive}">
              <views:CardHighlightConfigView DataContext="{Binding CardHighlight}"/>
            </Border>
            <Border IsVisible="{Binding IsPathsTabActive}">
              <views:PathsConfigView DataContext="{Binding Paths}"/>
            </Border>
            <Border IsVisible="{Binding IsPeripheralsTabActive}">
              <views:PeripheralConfigView DataContext="{Binding Peripherals}"/>
            </Border>
            <Border IsVisible="{Binding IsHooksTabActive}">
              <views:HookConfigView DataContext="{Binding Hooks}"/>
            </Border>
            <Border IsVisible="{Binding IsUpdatesTabActive}">
              <views:UpdateConfigView DataContext="{Binding Updates}"/>
            </Border>
            <Border IsVisible="{Binding IsScraperTabActive}">
              <views:ScraperConfigView DataContext="{Binding Scraper}"/>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- Hint bar / legend -->
      <Border Grid.Row="2"
              BorderBrush="{DynamicResource UGL.Divider}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22">
          <controls:ButtonHint Glyph="↑↓" Label="Navigate"/>
          <controls:ButtonHint Glyph="LB/RB" Label="Switch tab"/>
          <controls:ButtonHint Glyph="A" Label="Select"/>
          <controls:ButtonHint Glyph="B" Label="Close"/>
        </StackPanel>
      </Border>

    </Grid>

    <!-- Virtual keyboard overlay — topmost sibling so it renders above everything else.
         Same pattern as every other controller-navigable list here: bound properties
         (Label, IsHighlighted) driven directly in C#, no Avalonia focus system involved. -->
    <Border IsVisible="{Binding VirtualKeyboard.IsOpen}"
            Background="{DynamicResource UGL.ScrimHeavy}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="720">

        <TextBlock Text="{Binding VirtualKeyboard.FieldLabel}"
                   FontSize="16" Foreground="{DynamicResource UGL.TextSecondaryColor}" HorizontalAlignment="Center"/>

        <Border Background="{DynamicResource UGL.Divider}" CornerRadius="6" Padding="16,10" MinHeight="48">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding VirtualKeyboard.TextBeforeCursor}"
                       FontSize="22" Foreground="White"/>
            <Border Width="2" Margin="1,2" Background="{DynamicResource UGL.AccentColor}"/>
            <TextBlock Text="{Binding VirtualKeyboard.TextAfterCursor}"
                       FontSize="22" Foreground="White"/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding VirtualKeyboard.Row0Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VirtualKeyViewModel">
              <Border Width="52" Height="52" CornerRadius="4" Classes="vkKey"
                      Classes.keyHighlighted="{Binding IsHighlighted}">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="White"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VirtualKeyboard.Row1Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VirtualKeyViewModel">
              <Border Width="52" Height="52" CornerRadius="4" Classes="vkKey"
                      Classes.keyHighlighted="{Binding IsHighlighted}">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="White"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VirtualKeyboard.Row2Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VirtualKeyViewModel">
              <Border Width="52" Height="52" CornerRadius="4" Classes="vkKey"
                      Classes.keyHighlighted="{Binding IsHighlighted}">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="White"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VirtualKeyboard.Row3Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VirtualKeyViewModel">
              <Border Width="64" Height="52" CornerRadius="4" Classes="vkKey"
                      Classes.keyHighlighted="{Binding IsHighlighted}">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="White"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding VirtualKeyboard.Row4Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VirtualKeyViewModel">
              <Border Width="100" Height="52" CornerRadius="4" Classes="vkKey"
                      Classes.keyHighlighted="{Binding IsHighlighted}">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" Foreground="White"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="↑↓←→ Move      A Type key / Move cursor      B Cancel"
                   FontSize="12" Foreground="{DynamicResource UGL.TextSecondaryColor}" HorizontalAlignment="Center"/>

      </StackPanel>
    </Border>

    <!-- Delete-confirmation overlay — topmost sibling, same pattern as the virtual
         keyboard above. Defaults to "No" highlighted (see ConfirmDialogViewModel). -->
    <Border IsVisible="{Binding ConfirmDialog.IsOpen}"
            Background="#F00D0D1A">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Width="480">

        <TextBlock Text="{Binding ConfirmDialog.Message}"
                   FontSize="18" Foreground="White" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
          <Border Classes="cfgField" Classes.fieldFocused="{Binding ConfirmDialog.IsYesSelected}">
            <Button Content="Yes, Delete" Command="{Binding ConfirmDialog.ClickYesCommand}"
                    Background="#FFCC3333" Foreground="White" Padding="20,10"/>
          </Border>
          <Border Classes="cfgField" Classes.fieldFocused="{Binding !ConfirmDialog.IsYesSelected}">
            <Button Content="Cancel" Command="{Binding ConfirmDialog.ClickNoCommand}"
                    Padding="20,10"/>
          </Border>
        </StackPanel>

        <TextBlock Text="←→ Move      A Confirm      B Cancel"
                   FontSize="12" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
