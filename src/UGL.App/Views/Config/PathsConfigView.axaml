<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UGL.App.ViewModels.Config"
             xmlns:models="clr-namespace:UGL.Core.Models;assembly=UGL.Core"
             x:Class="UGL.App.Views.Config.PathsConfigView"
             x:DataType="vm:PathsConfigViewModel">

  <ScrollViewer Classes="contentScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="0,0,0,16">

      <!-- ── Root Paths ── -->
      <StackPanel Spacing="4">
        <TextBlock Text="Root Folders" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource UGL.TextPrimaryColor}"/>
        <TextBlock Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap"
                   Text="These are defaults. Individual games, systems and emulators can override any path to point anywhere on any drive."/>
      </StackPanel>

      <!-- Compact storage-locations table — one row per root instead of five tall
           repeated blocks. Description text moves to a hover/focus tooltip instead
           of always-on body text, so all five fit in the space the first two used to. -->
      <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="ROOT" FontSize="10" FontWeight="Bold"
                   LetterSpacing="1" Foreground="{DynamicResource UGL.TextSecondaryColor}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="PATH" FontSize="10" FontWeight="Bold"
                   LetterSpacing="1" Foreground="{DynamicResource UGL.TextSecondaryColor}" Margin="8,0,0,0"/>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Classes="sectionDivider" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Media" Foreground="White" FontSize="13" VerticalAlignment="Center"
                   ToolTip.Tip="Card art, video previews, sounds, music. Sub-folders (flat, no games\ prefix): categories\, covers\, backgrounds\, logos\, marquees\, cardart\, screenshots\, video\, sounds\, music\"/>
        <Border Grid.Row="2" Grid.Column="1" Classes="cfgField" Classes.fieldFocused="{Binding IsMediaRootFocused}" Padding="6,4" Margin="8,2,8,2">
          <TextBox Text="{Binding MediaRootPath}" Watermark="media  (relative to exe, or full path like D:\UGL\media)"/>
        </Border>
        <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Command="{Binding BrowseMediaRootCommand}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="ROMs" Foreground="White" FontSize="13" VerticalAlignment="Center"
                   ToolTip.Tip="Default ROM location. Sub-folders created per system ID (e.g. roms\arcade\, roms\nes\). Override per-system below."/>
        <Border Grid.Row="3" Grid.Column="1" Classes="cfgField" Classes.fieldFocused="{Binding IsRomsRootFocused}" Padding="6,4" Margin="8,2,8,2">
          <TextBox Text="{Binding RomsRootPath}" Watermark="roms  (or D:\ROMs, \\NAS\Games, etc.)"/>
        </Border>
        <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Command="{Binding BrowseRomsRootCommand}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Emulators" Foreground="White" FontSize="13" VerticalAlignment="Center"
                   ToolTip.Tip="Default location for emulator installations. Individual emulator paths in the Systems tab override this."/>
        <Border Grid.Row="4" Grid.Column="1" Classes="cfgField" Classes.fieldFocused="{Binding IsEmulatorsRootFocused}" Padding="6,4" Margin="8,2,8,2">
          <TextBox Text="{Binding EmulatorsRootPath}" Watermark="emulators  (or C:\Emulators)"/>
        </Border>
        <Button Grid.Row="4" Grid.Column="2" Content="Browse…" Command="{Binding BrowseEmulatorsRootCommand}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Addons" Foreground="White" FontSize="13" VerticalAlignment="Center"
                   ToolTip.Tip="MameHooker, Hook of the Reaper, and other peripheral integration tools."/>
        <Border Grid.Row="5" Grid.Column="1" Classes="cfgField" Classes.fieldFocused="{Binding IsAddonsRootFocused}" Padding="6,4" Margin="8,2,8,2">
          <TextBox Text="{Binding AddonsRootPath}" Watermark="addons"/>
        </Border>
        <Button Grid.Row="5" Grid.Column="2" Content="Browse…" Command="{Binding BrowseAddonsRootCommand}"/>
      </Grid>

      <!-- Logs Root — kept as its own row below the grid since RowDefinitions above
           are fixed at five data rows; same table styling. -->
      <Grid ColumnDefinitions="120,*,Auto">
        <TextBlock Grid.Column="0" Text="Logs" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Classes="cfgField" Classes.fieldFocused="{Binding IsLogsRootFocused}" Padding="6,4" Margin="8,2,8,2">
          <TextBox Text="{Binding LogsRootPath}" Watermark="logs"/>
        </Border>
        <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseLogsRootCommand}"/>
      </Grid>

      <!-- Save root paths -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="💾 Save Paths"
                Command="{Binding SaveAllPathsCommand}"
                Classes="cfgField" Classes.fieldFocused="{Binding IsSaveAllFocused}"
                Background="{DynamicResource UGL.AccentColor}"
                Foreground="White" Padding="16,8"/>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource UGL.SuccessColor}" VerticalAlignment="Center"
                   IsVisible="{Binding StatusMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>

      <Border Classes="sectionDivider" Margin="0,8,0,0"/>

      <!-- ── Per-System ROM Path Overrides ── -->
      <StackPanel Spacing="4">
        <TextBlock Text="Per-System ROM Paths" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource UGL.TextPrimaryColor}"/>
        <TextBlock Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap"
                   Text="Override the ROM folder for any individual system. Use this to point Pinball tables to D:\Pinball\Tables, Windows games to E:\Games, etc. Leave blank to use the ROMs Root above."/>
      </StackPanel>

      <Grid ColumnDefinitions="200,16,*">

        <!-- System list -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Systems}"
                 SelectedItem="{Binding SelectedSystem}"
                 Background="#11FFFFFF" MinHeight="200">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:GameSystem">
              <StackPanel Margin="4,4">
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13"/>
                <TextBlock Text="{Binding RomPath}" Foreground="#55FFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding RomPath,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- System ROM path editor -->
        <StackPanel Grid.Column="2" Spacing="8"
                    IsVisible="{Binding SelectedSystem,
                                Converter={x:Static ObjectConverters.IsNotNull}}">

          <TextBlock Text="{Binding SelectedSystem.Name}"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource UGL.TextPrimaryColor}"/>

          <TextBlock Foreground="#44FFFFFF" FontSize="11" TextWrapping="Wrap"
                     Text="Leave blank to use the ROMs Root default. Set to any path on any drive or network share."/>

          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding EditSystemRomPath}"
                     Watermark="Leave blank for default, or D:\Pinball\Tables, E:\Games, \\NAS\ROMs\nes…"/>
            <Button  Grid.Column="2" Content="Browse…"
                     Command="{Binding BrowseSystemRomPathCommand}"/>
          </Grid>

          <TextBlock Foreground="#66FFFFFF" FontSize="11"
                     Text="{Binding EditSystemRomPath,
                            StringFormat='Resolved: {0}',
                            FallbackValue='Using default ROM root'}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="💾 Save"
                    Command="{Binding SaveSystemRomPathCommand}"
                    Classes="cfgField" Classes.fieldFocused="{Binding IsSaveSystemFocused}"
                    Background="{DynamicResource UGL.AccentColor}"
                    Foreground="White" Padding="12,6"/>
            <Button Content="✕ Clear"
                    Padding="12,6"
                    Click="OnClearSystemRomPath"/>
          </StackPanel>

        </StackPanel>

      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
