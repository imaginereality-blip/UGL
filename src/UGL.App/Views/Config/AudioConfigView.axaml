<UserControl xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:vm="clr-namespace:UGL.App.ViewModels.Config"
       xmlns:models="clr-namespace:UGL.Core.Models;assembly=UGL.Core"
       x:Class="UGL.App.Views.Config.AudioConfigView"
       x:DataType="vm:AudioConfigViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tabActive">
      <Setter Property="Background" Value="{DynamicResource UGL.AccentColor}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="contentScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,0,0,16">

      <TextBlock Text="Audio" FontSize="18" FontWeight="Bold" Foreground="White"/>

      <!-- Sub-tab selector -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsMusicTabActive}">
          <Button Content="🎵 Music" Command="{Binding SelectMusicTabCommand}"
                  Classes.tabActive="{Binding IsMusicTabActive}"/>
        </Border>
        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsSoundsTabActive}">
          <Button Content="🔊 System Sounds" Command="{Binding SelectSoundsTabCommand}"
                  Classes.tabActive="{Binding IsSoundsTabActive}"/>
        </Border>
      </StackPanel>
      <TextBlock Text="Controller: LB/RB switches between these" Foreground="#66FFFFFF" FontSize="11"/>

      <!-- ═══════════════════════ MUSIC TAB ═══════════════════════ -->
      <StackPanel Spacing="16" IsVisible="{Binding IsMusicTabActive}">

        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsEnableMusicFocused}" Padding="6">
          <CheckBox IsChecked="{Binding EnableBackgroundMusic}" Content="Enable Background Music"/>
        </Border>
        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsMasterMusicVolumeFocused}" Padding="6">
          <Grid ColumnDefinitions="120,*,40">
            <TextBlock Grid.Column="0" Text="Master Volume" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Value="{Binding MasterMusicVolume}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
            <TextBlock Grid.Column="2" Text="{Binding MasterMusicVolume, StringFormat={}{0:P0}}"
                       Foreground="#88FFFFFF" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,16,*">

          <!-- Left pane: playlist selector + details -->
          <StackPanel Grid.Column="0" Spacing="8">

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistSelectorFocused}" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="Playlist" Foreground="#88FFFFFF" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AudioPlaylist">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="⭐" IsVisible="{Binding IsGlobal}" Foreground="#FFFFD700"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsNewPlaylistFocused}" Padding="6">
              <Button Content="＋ New Playlist" Command="{Binding AddNewPlaylistCommand}" HorizontalAlignment="Stretch"/>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistNameFocused}" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="Name" Foreground="#88FFFFFF" FontSize="12"/>
                <TextBox Text="{Binding EditPlaylistName}" Watermark="Unnamed Playlist"/>
              </StackPanel>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistGlobalFocused}" Padding="6">
              <StackPanel Spacing="2">
                <CheckBox IsChecked="{Binding EditPlaylistIsGlobal}" Content="Global Playlist"/>
                <TextBlock Text="Plays whenever nothing more specific is assigned. Only one playlist can be Global — checking this unchecks any other."
                           Foreground="#66FFFFFF" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistCategoriesFocused}" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="Categories (A to enter, Up/Down to move, A to toggle, B to exit)"
                           Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding EditPlaylistCategories}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistCategoryCheckItem">
                      <Border Classes="cfgField" Classes.fieldFocused="{Binding IsHighlighted}" Margin="0,2,8,2" Padding="4,2">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistVolumeFocused}" Padding="6">
              <Grid ColumnDefinitions="80,*,40">
                <TextBlock Grid.Column="0" Text="Volume" Foreground="#88FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                <Slider Grid.Column="1" Value="{Binding EditPlaylistVolume}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                <TextBlock Grid.Column="2" Text="{Binding EditPlaylistVolume, StringFormat={}{0:P0}}"
                           Foreground="#88FFFFFF" VerticalAlignment="Center" FontSize="12"/>
              </Grid>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsPlaylistShuffleFocused}" Padding="6">
              <CheckBox IsChecked="{Binding EditPlaylistShuffle}" Content="Shuffle"/>
            </Border>

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsDeletePlaylistFocused}" Padding="6">
              <Button Content="✕ Delete Playlist" Command="{Binding DeleteSelectedPlaylistCommand}"
                      Foreground="{DynamicResource UGL.DangerColor}" HorizontalAlignment="Stretch"/>
            </Border>

          </StackPanel>

          <!-- Right pane: track library + assignment -->
          <StackPanel Grid.Column="2" Spacing="8">

            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsAddTrackFocused}" Padding="6">
              <Button Content="＋ Add Track to Library…" Command="{Binding BrowseAddTrackCommand}" HorizontalAlignment="Stretch"/>
            </Border>

            <TextBlock Text="Available Tracks" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsAvailableTracksFocused}" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="Drag to Assigned below, or: A to enter, Up/Down to move, A to add, B to exit"
                           Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                <ListBox x:Name="AvailableTracksList"
                         ItemsSource="{Binding AvailableTracks}"
                         Background="#11FFFFFF" MinHeight="100" MaxHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistTrackItem">
                      <Border Classes="cfgField" Classes.fieldFocused="{Binding IsHighlighted}" Padding="4,2">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <TextBlock Text="In This Playlist" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
            <Border Classes="cfgField" Classes.fieldFocused="{Binding IsAssignedTracksFocused}" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="Drag to Available above, or: A to enter, Up/Down to move, A to remove, B to exit"
                           Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap"/>
                <ListBox x:Name="AssignedTracksList"
                         ItemsSource="{Binding AssignedTracks}"
                         Background="#11FFFFFF" MinHeight="100" MaxHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistTrackItem">
                      <Border Classes="cfgField" Classes.fieldFocused="{Binding IsHighlighted}" Padding="4,2">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="cfgField" Classes.fieldFocused="{Binding IsSaveMusicFocused}">
            <Button Content="💾 Save" Command="{Binding SaveCommand}"
                    Background="{DynamicResource UGL.AccentColor}" Foreground="White" Padding="16,8"/>
          </Border>
          <Border Classes="cfgField" Classes.fieldFocused="{Binding IsCancelMusicFocused}">
            <Button Content="Cancel" Command="{Binding CancelPlaylistEditsCommand}" Padding="16,8"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- ═══════════════════ SYSTEM SOUNDS TAB ═══════════════════ -->
      <StackPanel Spacing="12" IsVisible="{Binding IsSoundsTabActive}">

        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsEnableNavSoundsFocused}" Padding="6">
          <CheckBox IsChecked="{Binding EnableNavigationSounds}" Content="Enable Navigation Sounds"/>
        </Border>
        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsMasterSoundVolumeFocused}" Padding="6">
          <Grid ColumnDefinitions="120,*,40">
            <TextBlock Grid.Column="0" Text="Master Volume" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Value="{Binding MasterSoundVolume}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
            <TextBlock Grid.Column="2" Text="{Binding MasterSoundVolume, StringFormat={}{0:P0}}"
                       Foreground="#88FFFFFF" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,8,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <Border Grid.Row="0" Grid.Column="0" Classes="cfgField" Classes.fieldFocused="{Binding IsSoundNavigatePathFocused}" Padding="6" Margin="0,0,0,4">
            <StackPanel Spacing="2">
              <TextBlock Text="Navigate Sound" Foreground="#88FFFFFF" FontSize="11"/>
              <TextBox Text="{Binding SoundNavigatePath}" IsReadOnly="True"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Classes="cfgField" Classes.fieldFocused="{Binding IsTestNavigateFocused}" Margin="0,0,0,4" VerticalAlignment="Bottom">
            <Button Content="▶ Test" Command="{Binding TestNavigateSoundCommand}"/>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Classes="cfgField" Classes.fieldFocused="{Binding IsSoundConfirmPathFocused}" Padding="6" Margin="0,0,0,4">
            <StackPanel Spacing="2">
              <TextBlock Text="Confirm Sound" Foreground="#88FFFFFF" FontSize="11"/>
              <TextBox Text="{Binding SoundConfirmPath}" IsReadOnly="True"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Classes="cfgField" Classes.fieldFocused="{Binding IsTestConfirmFocused}" Margin="0,0,0,4" VerticalAlignment="Bottom">
            <Button Content="▶ Test" Command="{Binding TestConfirmSoundCommand}"/>
          </Border>

          <Border Grid.Row="2" Grid.Column="0" Classes="cfgField" Classes.fieldFocused="{Binding IsSoundBackPathFocused}" Padding="6" Margin="0,0,0,4">
            <StackPanel Spacing="2">
              <TextBlock Text="Back Sound" Foreground="#88FFFFFF" FontSize="11"/>
              <TextBox Text="{Binding SoundBackPath}" IsReadOnly="True"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="2" Classes="cfgField" Classes.fieldFocused="{Binding IsTestBackFocused}" Margin="0,0,0,4" VerticalAlignment="Bottom">
            <Button Content="▶ Test" Command="{Binding TestBackSoundCommand}"/>
          </Border>

          <Border Grid.Row="3" Grid.Column="0" Classes="cfgField" Classes.fieldFocused="{Binding IsSoundErrorPathFocused}" Padding="6">
            <StackPanel Spacing="2">
              <TextBlock Text="Error Sound" Foreground="#88FFFFFF" FontSize="11"/>
              <TextBox Text="{Binding SoundErrorPath}" IsReadOnly="True"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Grid.Column="2" Classes="cfgField" Classes.fieldFocused="{Binding IsTestErrorFocused}" VerticalAlignment="Bottom">
            <Button Content="▶ Test" Command="{Binding TestErrorSoundCommand}"/>
          </Border>
        </Grid>

        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsEnableVideoPreviewFocused}" Padding="6">
          <CheckBox IsChecked="{Binding EnableVideoPreviewAudio}" Content="Play Audio During Video Previews"/>
        </Border>
        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsVideoPreviewVolumeFocused}" Padding="6">
          <Grid ColumnDefinitions="120,*,40">
            <TextBlock Grid.Column="0" Text="Preview Volume" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Value="{Binding VideoPreviewVolume}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
            <TextBlock Grid.Column="2" Text="{Binding VideoPreviewVolume, StringFormat={}{0:P0}}"
                       Foreground="#88FFFFFF" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
        </Border>

        <Border Classes="cfgField" Classes.fieldFocused="{Binding IsSaveSoundsFocused}" HorizontalAlignment="Left">
          <Button Content="💾 Save" Command="{Binding SaveCommand}"
                  Background="{DynamicResource UGL.AccentColor}" Foreground="White" Padding="16,8"/>
        </Border>
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UGL.SuccessColor}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
