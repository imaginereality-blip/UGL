<UserControl xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:vm="clr-namespace:UGL.App.ViewModels.Config"
       xmlns:models="clr-namespace:UGL.Core.Models;assembly=UGL.Core"
       x:Class="UGL.App.Views.Config.ThemeConfigView"
       x:DataType="vm:ThemeConfigViewModel">

    <ScrollViewer Classes="contentScroll" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      Padding="0,0,0,16">
  <StackPanel Spacing="20">

    <TextBlock Text="Theme" FontSize="18" FontWeight="Bold" Foreground="White"/>
    <TextBlock Text="Changes apply immediately — no restart required."
               Foreground="#88FFFFFF" FontSize="13"/>

    <!-- Theme cards — the one real, bound picker (recommendation 9). SelectedItem
         lives directly on this ListBox; the three dots reflect each theme's own
         colors instead of a hardcoded literal identical on every card. Controller
         Up/Down browses via ThemeConfigViewModel.NavigateUp/Down, same as every
         other list in Settings. -->
    <ListBox ItemsSource="{Binding AvailableThemes}"
             SelectedItem="{Binding SelectedTheme}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:Theme">
          <!-- Each theme renders as a clickable swatch card -->
          <Border Width="200" Height="140"
                  Margin="8"
                  CornerRadius="6"
                  Padding="12"
                  Cursor="Hand">
            <Border.Background>
              <SolidColorBrush Color="#FF1A1A2E"/>
            </Border.Background>
            <StackPanel Spacing="8">
              <!-- Colour swatches row — bound to this theme's own colors -->
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="20" Height="20" CornerRadius="10"
                        Background="{Binding AccentColor}"/>
                <Border Width="20" Height="20" CornerRadius="10"
                        Background="{Binding BackgroundColor}"/>
                <Border Width="20" Height="20" CornerRadius="10"
                        Background="{Binding SurfaceColor}"/>
              </StackPanel>
              <TextBlock Text="{Binding Name}"
                         FontSize="16" FontWeight="Bold"
                         Foreground="White"/>
              <TextBlock Text="{Binding Id}"
                         FontSize="11"
                         Foreground="#88FFFFFF"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="✔ Apply Theme"
              Command="{Binding ApplyThemeCommand}"
              IsEnabled="{Binding SelectedTheme, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource UGL.AccentColor}"
              Foreground="White"
              Padding="16,8"/>
      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource UGL.SuccessColor}"
                 VerticalAlignment="Center"
                 IsVisible="{Binding StatusMessage,
                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

  </StackPanel>
  </ScrollViewer>
</UserControl>
