<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UGL.App.ViewModels.Config"
             xmlns:models="clr-namespace:UGL.Core.Models;assembly=UGL.Core"
             x:Class="UGL.App.Views.Config.PeripheralConfigView"
             x:DataType="vm:PeripheralConfigViewModel">

  <UserControl.Styles>
    <!-- Highlights whichever row/button currently has controller focus inside this
         tab (Rescan, or a device row via the ListBox's own selection highlight) -->
    <Style Selector="Button.controllerFocused">
      <Setter Property="BorderBrush" Value="{DynamicResource UGL.AccentColor}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Peripheral Devices" FontSize="18" FontWeight="Bold" Foreground="White"/>
      <TextBlock FontSize="13" Foreground="#88FFFFFF" TextWrapping="Wrap"
                 Text="Assign player indices to lightguns, wheels, and other HID peripherals. Player 0 = unassigned."/>

      <!-- HidHide — makes Game.DisabledDeviceTypes (Games tab) a real, OS-level
           per-game disable instead of only affecting UGL's own input pipeline. -->
      <Border Classes="cfgField" Classes.fieldFocused="{Binding IsHidHideEnabledFocused}" Padding="4" Margin="0,8,0,0">
        <Border Background="#22FFFFFF" CornerRadius="6" Padding="12">
          <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding HidHideEnabled}"
                      Content="Enable HidHide (real per-game peripheral disable)"
                      FontWeight="SemiBold"/>
            <TextBlock Text="Requires HidHide (github.com/nefarius/HidHide) installed separately. Without this, a game's Disabled Peripherals (Games tab) only silences UGL's own input handling — the emulator itself still sees the device."
                       Foreground="#66FFFFFF" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Border>
      <Border IsVisible="{Binding HidHideEnabled}"
              Classes="cfgField" Classes.fieldFocused="{Binding IsHidHideCliPathFocused}" Padding="6">
        <StackPanel Spacing="4">
          <TextBlock Text="HidHideCLI.exe Path" Foreground="#88FFFFFF" FontSize="11"/>
          <TextBox Text="{Binding HidHideCliPath}" IsReadOnly="True" Watermark="Browse to select…"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="🔍 Rescan Devices"
                Command="{Binding RescanDevicesCommand}"
                Classes.controllerFocused="{Binding IsRescanFocused}"
                Padding="12,6"/>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#FF44FF88"
                   VerticalAlignment="Center"
                   IsVisible="{Binding StatusMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </StackPanel>

    <!-- Device list -->
    <Grid Grid.Row="1" ColumnDefinitions="*,16,280">

      <ListBox Grid.Column="0"
               ItemsSource="{Binding Devices}"
               SelectedItem="{Binding SelectedDevice}"
               Background="#11FFFFFF">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:RawInputDevice">
            <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="4,6">

              <!-- Connection indicator: ● green if connected, ○ dim if not -->
              <TextBlock Grid.Column="0"
                         Text="{Binding IsConnected, StringFormat={}{0}}"
                         VerticalAlignment="Center"
                         FontSize="16"
                         Foreground="#FF44FF88"/>

              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="{Binding FriendlyName}"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DeviceType}"
                             Foreground="#66FFFFFF" FontSize="11"/>
                  <TextBlock Text="FFB?"
                             ToolTip.Tip="Best-effort: this device exposes a force-feedback HID collection. Not a guarantee, and UGL never drives FFB itself — the game/emulator does that via its own DirectInput calls."
                             IsVisible="{Binding IsForceFeedbackCapable}"
                             Foreground="#FFFFD700" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Text="{Binding HardwarePath}"
                             Foreground="#33FFFFFF" FontSize="10"
                             TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </StackPanel>
              </StackPanel>

              <!-- Player index label -->
              <TextBlock Grid.Column="4"
                         Text="{Binding PlayerIndex, StringFormat='P{0}'}"
                         Foreground="{DynamicResource UGL.AccentColor}"
                         FontSize="13" FontWeight="Bold"
                         VerticalAlignment="Center"/>

            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Detail panel -->
      <Border Grid.Column="2"
              Background="#11FFFFFF"
              CornerRadius="6"
              Padding="16"
              IsVisible="{Binding SelectedDevice,
                          Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12">

          <TextBlock Text="{Binding SelectedDevice.FriendlyName}"
                     FontSize="15" FontWeight="Bold" Foreground="White"
                     TextWrapping="Wrap"/>

          <StackPanel Spacing="2">
            <TextBlock Text="Type" Foreground="#88FFFFFF" FontSize="11"/>
            <TextBlock Text="{Binding SelectedDevice.DeviceType}"
                       Foreground="White" FontSize="13"/>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="Status" Foreground="#88FFFFFF" FontSize="11"/>
            <TextBlock Foreground="#FF44FF88" FontSize="13"
                       Text="{Binding SelectedDevice.IsConnected,
                              StringFormat={}{0}}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Assign Player Index" Foreground="#88FFFFFF" FontSize="11"/>
            <TextBlock Text="0 = unassigned" Foreground="#55FFFFFF" FontSize="11"/>
            <ComboBox ItemsSource="{Binding PlayerIndexOptions}"
                      SelectedItem="{Binding EditPlayerIndex}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>

          <StackPanel Spacing="8">
            <Button Content="✔ Assign"
                    Command="{Binding AssignPlayerIndexCommand}"
                    Background="{DynamicResource UGL.AccentColor}"
                    Foreground="White" Padding="12,6"
                    HorizontalAlignment="Stretch"/>
            <Button Content="✕ Remove from Registry"
                    Command="{Binding RemoveDeviceCommand}"
                    Padding="12,6"
                    HorizontalAlignment="Stretch"/>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Placeholder -->
      <Border Grid.Column="2"
              IsVisible="{Binding SelectedDevice,
                          Converter={x:Static ObjectConverters.IsNull}}"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Select a device to configure"
                   Foreground="#44FFFFFF" FontSize="14"/>
      </Border>

    </Grid>

    <!-- Loading indicator -->
    <TextBlock Grid.Row="2"
               Text="Scanning…"
               IsVisible="{Binding IsLoading}"
               Foreground="#88FFFFFF" FontSize="13"
               Margin="0,8,0,0"/>

  </Grid>
</UserControl>
