<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UGL.App.ViewModels"
             xmlns:views="clr-namespace:UGL.App.Views"
             xmlns:controls="clr-namespace:UGL.App.Views.Controls"
             x:Class="UGL.App.Views.CategoryCard"
             x:DataType="vm:CategoryCardViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Border Name="CardBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="{DynamicResource UGL.CardSpacing}"
            ClipToBounds="True"
            Background="{DynamicResource UGL.SurfaceColor}">

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <TextBlock Name="PlaceholderText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="140"
                       FontWeight="Black"
                       Opacity="0.15"
                       Foreground="{DynamicResource UGL.TextPrimaryColor}"
                       Text="{Binding PlaceholderLetter}" />

            <!-- Source is NOT bound — set directly in code-behind -->
            <Image Name="CoverImage"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsVisible="False" />

            <!-- Title graphic — the category's own title text overlaid on the card
                 (Settings → Title Graphics), rendered by the reusable
                 CategoryTitleGraphic control (see its own doc comment for the full
                 style rationale — direction 28b in
                 category_card_title_overlay/README.md). Visibility/scale/position
                 driven from code-behind via TitleGraphicsSettings (a static
                 live-settings bridge, same pattern as the selection glow above).
                 TitleGraphicsSettings.Scale is now the ONLY width control — there is
                 deliberately no separate fixed-percentage column reservation here
                 (there used to be a 5/90/5 split plus a fixed 1.15x bump on top of
                 it, which double-counted and pushed content past the card's own
                 ClipToBounds edge). The base Viewbox/Image fills the full cell minus
                 a small fixed margin; Scale/PositionX/PositionY (user-adjustable
                 sliders) are applied as a post-fit RenderTransform on
                 TitleGraphicCell. -->
            <Grid Name="TitleGraphicContainer" IsVisible="False">
                <Grid Name="TitleGraphicCell"
                      RenderTransformOrigin="50%,50%">
                    <!-- Preferred: the real 3D bake (TitleGraphicsBaker), a transparent PNG
                         rendered offscreen via WebView2/three.js — see
                         category_card_title_overlay/3D Title Graphic Bake - Implementation
                         Spec.md. Shown/hidden from code-behind once a fresh bake exists for
                         this category. -->
                    <Image Name="TitleGraphicBakedImage" Stretch="Uniform"
                           IsVisible="False" Margin="12">
                        <Image.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" OffsetX="0" OffsetY="10" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                    <!-- Fallback: the live 2D stacked-TextBlock overlay (see its own doc
                         comment) — shown until a bake exists or completes for this
                         category, and if WebView2 isn't available on this machine at all. -->
                    <Viewbox Name="TitleGraphicLiveFallback" Stretch="Uniform" StretchDirection="Both" Margin="12">
                        <Viewbox.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" OffsetX="0" OffsetY="10" Opacity="0.5"/>
                        </Viewbox.Effect>
                        <controls:CategoryTitleGraphic
                            TitleText="{Binding Category.Label, Converter={x:Static views:UppercaseConverter.Instance}}"/>
                    </Viewbox>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>
