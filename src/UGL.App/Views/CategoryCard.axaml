<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UGL.App.ViewModels"
             xmlns:views="clr-namespace:UGL.App.Views"
             xmlns:controls="clr-namespace:UGL.App.Views.Controls"
             x:Class="UGL.App.Views.CategoryCard"
             x:DataType="vm:CategoryCardViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Border Name="CardBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="{DynamicResource UGL.CardSpacing}"
            ClipToBounds="True"
            Background="{DynamicResource UGL.SurfaceColor}">

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <TextBlock Name="PlaceholderText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="140"
                       FontWeight="Black"
                       Opacity="0.15"
                       Foreground="{DynamicResource UGL.TextPrimaryColor}"
                       Text="{Binding PlaceholderLetter}" />

            <!-- Source is NOT bound — set directly in code-behind -->
            <Image Name="CoverImage"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsVisible="False" />

            <!-- Title graphic — the category's own title text overlaid on the card
                 (Settings → Title Graphics), rendered by the reusable
                 CategoryTitleGraphic control (see its own doc comment for the full
                 style rationale — direction 28b in
                 category_card_title_overlay/README.md). Visibility/placement driven
                 from code-behind via TitleGraphicsSettings (a static live-settings
                 bridge, same pattern as the selection glow above). Row split
                 (top/middle/bottom zones) gives the vertical placement; the 5/90/5
                 column split plus the enclosing Viewbox gives the 90%-of-width
                 sizing, scaling the whole graphic (extrusion offsets, outline, drop
                 shadow included) uniformly regardless of the card's actual rendered
                 size. Text is always uppercased. -->
            <Grid Name="TitleGraphicContainer" IsVisible="False"
                  RowDefinitions="0.3*,0.4*,0.3*">
                <!-- RenderTransform (below) is set in code-behind: a fixed 1.15x scale
                     applied after Viewbox's own auto-fit (per feedback — Viewbox
                     normalizes to fill its box regardless of any scale applied to its
                     child, so growing the rendered result has to happen post-fit, on
                     this cell, not inside the Viewbox), plus a Bottom-placement-only
                     downward nudge computed from the card's actual rendered height. -->
                <Grid Name="TitleGraphicCell" Grid.Row="1"
                      ColumnDefinitions="0.05*,0.9*,0.05*"
                      RenderTransformOrigin="50%,50%">
                    <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="Both" Margin="0,10">
                        <Viewbox.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" OffsetX="0" OffsetY="10" Opacity="0.5"/>
                        </Viewbox.Effect>
                        <controls:CategoryTitleGraphic
                            TitleText="{Binding Category.Label, Converter={x:Static views:UppercaseConverter.Instance}}"/>
                    </Viewbox>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</UserControl>
