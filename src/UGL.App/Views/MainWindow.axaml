<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UGL.App.ViewModels"
        xmlns:views="clr-namespace:UGL.App.Views"
        x:Class="UGL.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1920"
        Height="1080"
        WindowState="FullScreen"
        SystemDecorations="None"
        Background="#FF1A1A2E">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeMenuViewModel">
            <views:HomeMenuView />
        </DataTemplate>
        <DataTemplate DataType="vm:GameBrowserViewModel">
            <views:GameBrowserView />
        </DataTemplate>
    </Window.DataTemplates>

    <!-- Panel lets the filter overlay sit on top of the active view -->
    <Panel>

        <!-- Loading splash -->
        <TextBlock IsVisible="{Binding IsLoading}"
                   Text="Loading…"
                   Foreground="White"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!-- Active level (Home Menu or Game Browser) -->
        <ContentControl IsVisible="{Binding !IsLoading}"
                        Content="{Binding CurrentView}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- Filter overlay — floats above everything, only visible when open -->
        <views:FilterOverlayView x:Name="FilterOverlay"
                                 DataContext="{Binding FilterOverlay}"
                                 IsVisible="False" />

        <!-- Settings overlay -->
        <views:ConfigEditorView x:Name="ConfigEditor"
                                DataContext="{Binding ConfigEditor}"
                                IsVisible="False" />

        <!-- Launch error toast — shown briefly when emulator fails to start. Dark
             surface with a colored left stripe + status glyph, matching every other
             surface in the app, instead of a bright solid-color pill. -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,80"
                Padding="18,12,22,12"
                CornerRadius="4"
                Background="{DynamicResource UGL.SurfaceColor}"
                BorderBrush="{DynamicResource UGL.DangerColor}"
                BorderThickness="3,0,0,0"
                IsVisible="{Binding LaunchError,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons"
                           Foreground="{DynamicResource UGL.DangerColor}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LaunchError}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Update notification — shown after a background check finds a new
             version. Stays visible (not auto-hidden) until Settings is opened,
             since it's more actionable than the playlist/launch-error toasts and
             easy to miss if it vanished on its own after a few seconds. Same dark
             surface + accent-stripe language as the error toast above. -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,24,0,0"
                Padding="18,12,22,12"
                CornerRadius="4"
                Background="{DynamicResource UGL.SurfaceColor}"
                BorderBrush="{DynamicResource UGL.AccentColor}"
                BorderThickness="3,0,0,0"
                IsVisible="{Binding IsUpdateNotificationVisible}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons"
                           Foreground="{DynamicResource UGL.AccentColor}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UpdateNotificationText}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Panel>
</Window>
