<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <RootNamespace>UGL.App</RootNamespace>
    <AssemblyName>UGL</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.6.0</Version>
    <!-- Only used by TitleGraphicsBaker to host the official WebView2 WinForms control
         on its own dedicated off-screen thread — no WinForms UI is ever shown to the
         user, Avalonia remains the app's real UI. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UGL.Core\UGL.Core.csproj" />
    <ProjectReference Include="..\UGL.Data\UGL.Data.csproj" />
    <ProjectReference Include="..\UGL.Media\UGL.Media.csproj" />
    <ProjectReference Include="..\UGL.Emulators\UGL.Emulators.csproj" />
    <ProjectReference Include="..\UGL.Themes\UGL.Themes.csproj" />
    <ProjectReference Include="..\UGL.Configuration\UGL.Configuration.csproj" />
    <ProjectReference Include="..\UGL.Input\UGL.Input.csproj" />
    <ProjectReference Include="..\UGL.Hooks\UGL.Hooks.csproj" />
    <ProjectReference Include="..\UGL.Updates\UGL.Updates.csproj" />
    <ProjectReference Include="..\UGL.Scraping\UGL.Scraping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms auto-adds these two as global usings, which collides with
         Avalonia's own Size/Color/Image/UserControl/Point/Bitmap types project-wide.
         TitleGraphicsBaker.cs (the only file that needs them) uses fully-qualified or
         locally-scoped `using` directives instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain disk files (not compiled AvaloniaResource) — TitleGraphicsBaker navigates
         WebView2 to these via a file:// URI, so they must exist as real files next to
         the exe, not be embedded in the assembly. -->
    <None Include="TitleGraphicsBakeAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
