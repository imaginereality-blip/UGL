  },
  "8": {
    "inputs": {
      "pixels": ["7", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode collage as img2img starting latent"
    }
  },
  "9": {
    "inputs": {
      "text": "{{PROMPT}}, poster composition, cohesive collage, unified lighting",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Positive Prompt)"
    }
  },
  "10": {
    "inputs": {
      "text": "low quality, blurry, watermark, text, words, letters, signature, logo, new characters, invented scene, bad anatomy, extra limbs, extra digits, missing digits, deformed, ugly, jpeg artifacts",
