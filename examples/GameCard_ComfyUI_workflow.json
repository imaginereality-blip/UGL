  "2": {
    "inputs": {
      "image": "{{IMAGE_1}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference Image 1 (cover)"
    }
  },
  "3": {
    "inputs": {
      "image": "{{IMAGE_2}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference Image 2 (screenshot)"
