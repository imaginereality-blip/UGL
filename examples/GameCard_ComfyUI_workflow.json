  },
  "4": {
    "inputs": {
      "image": "{{IMAGE_3}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference Image 3 (screenshot)"
    }
  },
  "5": {
    "inputs": {
      "image1": ["3", 0],
      "image2": ["4", 0],
      "direction": "right",
      "match_image_size": true,
      "spacing_width": 0,
      "spacing_color": "white"
    },
    "class_type": "ImageStitch",
    "_meta": {
      "title": "Stitch bottom row: screenshots side-by-side"
    }
  },
  "6": {
    "inputs": {
      "image1": ["2", 0],
      "image2": ["5", 0],
      "direction": "down",
      "match_image_size": true,
      "spacing_width": 0,
      "spacing_color": "white"
    },
    "class_type": "ImageStitch",
    "_meta": {
      "title": "Stitch cover on top of screenshot row"
    }
  },
  "7": {
    "inputs": {
      "upscale_method": "bicubic",
      "width": 752,
      "height": 1968,
      "crop": "center",
      "image": ["6", 0]
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Cover-fit collage into working canvas (752x1968)"
