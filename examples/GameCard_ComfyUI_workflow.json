    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Negative Prompt)"
    }
  },
  "12": {
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 5.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "{{DENOISE}}",
      "model": ["1", 0],
      "positive": ["9", 0],
      "negative": ["10", 0],
      "latent_image": ["8", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (low denoise img2img — harmonize, don't reinvent)"
    }
  },
  "13": {
    "inputs": {
      "samples": ["12", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "14": {
    "inputs": {
      "upscale_method": "bicubic",
      "width": 756,
      "height": 1968,
      "crop": "disabled",
      "image": ["13", 0]
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Force Exact Card Resolution (756x1968)"
